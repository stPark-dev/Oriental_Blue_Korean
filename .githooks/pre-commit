#!/bin/sh
# ROM·대용량 바이너리가 커밋되는 것을 막습니다.
# 설치: git config core.hooksPath .githooks   (또는 make hooks)
#
# 일시적으로 우회하려면:  ALLOW_BIG=1 git commit ...
# 단, ROM 확장자는 ALLOW_BIG 으로도 통과하지 않습니다.

set -u

MAX_BYTES=${MAX_BYTES:-1048576}          # 1MB
BLOCKED_EXT='gba|nds|sfc|smc|n64|z64|iso|bin|sav|srm|ips|bps|ups|xdelta'

fail=0
red=''; yellow=''; reset=''
if [ -t 2 ]; then
	red=$(printf '\033[31m'); yellow=$(printf '\033[33m'); reset=$(printf '\033[0m')
fi

# 스테이징된 파일 (추가/수정/복사/이름변경만; 삭제는 제외)
staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$staged" ] && exit 0

# 1) 금지 확장자
while IFS= read -r f; do
	[ -z "$f" ] && continue
	ext=$(printf '%s' "$f" | tr 'A-Z' 'a-z' | sed -n 's/.*\.\([A-Za-z0-9]*\)$/\1/p')
	[ -z "$ext" ] && continue
	if printf '%s' "$ext" | grep -qxE "$BLOCKED_EXT"; then
		printf '%s[차단]%s ROM/바이너리 확장자: %s\n' "$red" "$reset" "$f" >&2
		fail=1
	fi
done <<GITEOF
$staged
GITEOF

# 2) 용량 초과 (blob 크기 기준 — 작업 폴더가 아니라 실제 커밋될 내용)
while IFS= read -r line; do
	[ -z "$line" ] && continue
	# raw 형식: :<srcmode> <dstmode> <srcsha> <dstsha> <status>	<path>
	sha=$(printf '%s' "$line" | awk '{print $4}')
	path=$(printf '%s' "$line" | cut -f2-)
	[ "$sha" = "0000000000000000000000000000000000000000" ] && continue
	size=$(git cat-file -s "$sha" 2>/dev/null) || continue
	if [ "$size" -gt "$MAX_BYTES" ]; then
		if [ "${ALLOW_BIG:-0}" = "1" ]; then
			printf '%s[허용]%s %s (%s바이트) — ALLOW_BIG=1\n' "$yellow" "$reset" "$path" "$size" >&2
		else
			printf '%s[차단]%s 용량 초과: %s (%s바이트 > %s)\n' \
				"$red" "$reset" "$path" "$size" "$MAX_BYTES" >&2
			fail=1
		fi
	fi
done <<GITEOF
$(git diff --cached --raw --diff-filter=ACMR)
GITEOF

if [ "$fail" -ne 0 ]; then
	cat >&2 <<'MSG'

커밋이 중단되었습니다.

이 저장소는 ROM과 패치 결과물을 배포하지 않습니다.
해당 파일을 스테이징에서 빼세요:

    git restore --staged <파일>

.gitignore 에 규칙이 있는데도 걸렸다면, 이미 추적 중인 파일입니다:

    git rm --cached <파일>

용량 때문이라면 ALLOW_BIG=1 git commit ... 으로 한 번만 통과시킬 수 있습니다.
MSG
	exit 1
fi

exit 0
