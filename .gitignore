# ROM 및 파생 바이너리 — 절대 커밋하지 않습니다
rom/*
!rom/.gitkeep
*.gba
*.bin
*.sav
*.srm
*.ips
*.bps

# 외부 배포물(영문 패치 등)에 동봉된 파일
ReadMe.txt
readme.txt
*.txt.bak

# 원문 스크립트 — ROM 파생물이므로 커밋하지 않습니다.
# 각자 자기 ROM에서 make script 로 재생성하세요.
script/ja/*
!script/ja/.gitkeep

# 빌드 산출물
build/*
!build/.gitkeep
patch/*.ips
patch/*.bps

# 폰트 원본(라이선스 확인 전까지 미포함)
font/*.ttf
font/*.otf
font/*.bdf

# 파이썬
__pycache__/
*.py[cod]
.venv/
venv/

# 에디터 / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
